{
  "name": "compressed-log-viewer",
  "displayName": "Compressed Log Viewer",
  "description": "View compressed log files (XZ, bzip2, Zstandard) directly in VS Code",
  "version": "1.0.1",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "compressed-log-viewer.compressed",
        "displayName": "Compressed File Viewer",
        "selector": [
          {
            "filenamePattern": "*.xz"
          },
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.bz2"
          },
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.zst"
          },
          {
            "filenamePattern": "*.tar.zst"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "mocha",
    "pretest": "tsc -p src/test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "~22.17.0",
    "@types/tar-stream": "^3.1.5",
    "@types/unbzip2-stream": "^1.4.3",
    "@types/vscode": "1.103.0",
    "chai": "^4.3.10",
    "eslint": "~10.14.0",
    "mocha": "^10.2.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "lzma-native": "^8.0.6",
    "tar-stream": "^3.1.7",
    "unbzip2-stream": "^1.4.3"
  },
  "publisher": "hankhsu1996",
  "repository": {
    "type": "git",
    "url": "https://github.com/hankhsu1996/compressed-log-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/hankhsu1996/compressed-log-viewer/issues"
  },
  "homepage": "https://github.com/hankhsu1996/compressed-log-viewer",
  "license": "MIT",
  "author": {
    "name": "Shou-Li Hsu",
    "email": "hank850503@gmail.com"
  }
}
